# nginx-sso and the service it protects on one vhost: the login form is at
# https://example.com/sso/login, nginx-sso is configured with
#
#   web:
#     listen: "127.0.0.1:1234"
#     base-path: /sso
#
# Without base-path nginx-sso works as well if the prefix is stripped, use
# 'proxy_pass http://127.0.0.1:1234/;' in location /sso/ and
# 'proxy_pass http://127.0.0.1:1234/auth;' in location = /sso-auth then.
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name example.com;

  ssl_certificate     /etc/ssl/certs/example.com-cert.pem;
  ssl_certificate_key /etc/ssl/certs/example.com-key.pem;

  auth_request /sso-auth;
  error_page 401 = @error401;
  # Make username and escaped redir url available as varaiables.
  # Please keep in mind that auth_request_set options inside of another
  # context completely overrides this and at least the $whawty_sso_login_redir
  # variable must be present in any context for error401 handler to work.
  auth_request_set $whawty_sso_username $upstream_http_x_username;
  auth_request_set $whawty_sso_login_redir $upstream_http_x_login_redir;

  location /sso/ {
    # no URI after the address, so the path is passed on as is
    proxy_pass http://127.0.0.1:1234;
    # needed to check where form posts come from in browsers which don't send Sec-Fetch-Site
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    # This makes sure to drop the header in case $whawty_sso_username is unset for some reason
    proxy_set_header X-Username "";
    proxy_set_header X-Username $whawty_sso_username;

    proxy_pass http://127.0.0.1:8080/;
  }

  location = /sso-auth {
    internal;

    proxy_pass http://127.0.0.1:1234/sso/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    # without X-Host nginx-sso returns just the path in X-Login-Redir, which is all it
    # takes since the login form is on the same host
    proxy_set_header X-Origin-URI $request_uri;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # $login_redir is $request_uri escaped for use as query parameter, which nginx
  # can't do itself
  location @error401 {
    return 302 /sso/login?redir=$whawty_sso_login_redir;
  }
}
