server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name some-service.example.com;

  ssl_certificate     /etc/ssl/certs/some-service.example.com-cert.pem;
  ssl_certificate_key /etc/ssl/certs/some-service.example.com-key.pem;

  # in case authentication fails - redirect to login form
  error_page 401 = @error401;

  location / {
    auth_request /auth;

    # pass the X-Username header on to the protected service
    auth_request_set $username $upstream_http_x_username;
    proxy_set_header X-Username $username;
    # the URL of this request escaped for the login form, see @error401
    auth_request_set $login_redir $upstream_http_x_login_redir;

    proxy_pass http://127.0.0.1:8080/;
  }

  location /auth {
    internal;

    # if nginx-sso uses web.base-path, put it in front of /auth here
    proxy_pass http://127.0.0.1:1234/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Origin-URI $request_uri;
    proxy_set_header X-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # $login_redir is $scheme://$host$request_uri escaped for use as query parameter, which
  # nginx can't do itself. nginx-sso only redirects to hosts which get the session cookie:
  # the cookie domain (cookie.domain) and its subdomains or, without a cookie domain, its
  # own host
  location @error401 {
    return 302 https://login.example.com/login?redir=$login_redir;
  }
}

# the login form, the session cookie must be valid for all services (cookie.domain: example.com)
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name login.example.com;

  ssl_certificate     /etc/ssl/certs/login.example.com-cert.pem;
  ssl_certificate_key /etc/ssl/certs/login.example.com-key.pem;

  location / {
    proxy_pass http://127.0.0.1:1234/;
    # needed to check where form posts come from in browsers which don't send Sec-Fetch-Site
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
